{
  "openapi": "3.1.0",
  "info": {
    "title": "RemoteLens public API",
    "version": "1.0.0",
    "description": "Unauthenticated, read-only, structured remote developer-job catalog API. CV files remain local to the client."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/jobs": {
      "get": {
        "operationId": "listJobs",
        "summary": "List canonical engineering jobs",
        "parameters": [
          { "$ref": "#/components/parameters/cursor" },
          { "$ref": "#/components/parameters/limit" },
          { "$ref": "#/components/parameters/source" },
          { "$ref": "#/components/parameters/company" },
          { "$ref": "#/components/parameters/role_family" },
          { "$ref": "#/components/parameters/seniority" },
          { "$ref": "#/components/parameters/employment_type" },
          { "$ref": "#/components/parameters/remote_scope" },
          { "$ref": "#/components/parameters/country" },
          { "$ref": "#/components/parameters/region" },
          { "$ref": "#/components/parameters/timezone" },
          { "$ref": "#/components/parameters/tag" },
          { "$ref": "#/components/parameters/tag_mode" },
          { "$ref": "#/components/parameters/salary_min" },
          { "$ref": "#/components/parameters/salary_currency" },
          { "$ref": "#/components/parameters/salary_period" },
          { "$ref": "#/components/parameters/visa_sponsorship" },
          { "$ref": "#/components/parameters/travel_required" },
          { "$ref": "#/components/parameters/published_after" },
          { "$ref": "#/components/parameters/first_seen_after" },
          { "$ref": "#/components/parameters/status" },
          { "$ref": "#/components/parameters/sort" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/JobList" },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "operationId": "getJob",
        "summary": "Get one canonical job and its evidence",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/JobDetail" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/taxonomy": {
      "get": {
        "operationId": "getTaxonomy",
        "summary": "Get fixed structured filter vocabularies",
        "responses": {
          "200": { "$ref": "#/components/responses/Taxonomy" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "operationId": "getCatalogMetadata",
        "summary": "Get provider freshness and catalog metadata",
        "responses": {
          "200": { "$ref": "#/components/responses/Meta" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/feeds/jobs.json": {
      "get": {
        "operationId": "getJsonFeed",
        "summary": "Get active jobs as a compact JSON feed",
        "responses": {
          "200": { "$ref": "#/components/responses/JobList" },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      }
    },
    "/feeds/jobs.xml": {
      "get": {
        "operationId": "getRssFeed",
        "summary": "Get active jobs as RSS",
        "responses": {
          "200": {
            "description": "RSS feed containing active compact job summaries.",
            "content": {
              "application/rss+xml": { "schema": { "type": "string" } }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "cursor": {
        "name": "cursor",
        "in": "query",
        "schema": { "type": "string" }
      },
      "limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "source": {
        "name": "source",
        "in": "query",
        "style": "form",
        "explode": true,
        "schema": { "type": "array", "items": { "enum": ["remote_ok", "wwr"] } }
      },
      "company": {
        "name": "company",
        "in": "query",
        "schema": { "type": "string" }
      },
      "role_family": {
        "name": "role_family",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": ["engineering"],
          "default": "engineering"
        }
      },
      "seniority": {
        "name": "seniority",
        "in": "query",
        "schema": { "type": "string" }
      },
      "employment_type": {
        "name": "employment_type",
        "in": "query",
        "schema": { "type": "string" }
      },
      "remote_scope": {
        "name": "remote_scope",
        "in": "query",
        "schema": { "type": "string" }
      },
      "country": {
        "name": "country",
        "in": "query",
        "schema": { "type": "string", "pattern": "^[A-Z]{2}$" }
      },
      "region": {
        "name": "region",
        "in": "query",
        "schema": { "type": "string" }
      },
      "timezone": {
        "name": "timezone",
        "in": "query",
        "schema": { "type": "string" }
      },
      "tag": {
        "name": "tag",
        "in": "query",
        "style": "form",
        "explode": true,
        "schema": { "type": "array", "items": { "type": "string" } }
      },
      "tag_mode": {
        "name": "tag_mode",
        "in": "query",
        "schema": { "type": "string", "enum": ["all", "any"], "default": "all" }
      },
      "salary_min": {
        "name": "salary_min",
        "in": "query",
        "schema": { "type": "integer", "minimum": 0 }
      },
      "salary_currency": {
        "name": "salary_currency",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": ["AUD", "CAD", "EUR", "GBP", "JPY", "USD"]
        }
      },
      "salary_period": {
        "name": "salary_period",
        "in": "query",
        "schema": { "type": "string", "enum": ["hour", "month", "year"] }
      },
      "visa_sponsorship": {
        "name": "visa_sponsorship",
        "in": "query",
        "schema": { "type": "string", "enum": ["yes", "no"] }
      },
      "travel_required": {
        "name": "travel_required",
        "in": "query",
        "schema": { "type": "string", "enum": ["yes", "no"] }
      },
      "published_after": {
        "name": "published_after",
        "in": "query",
        "schema": { "type": "string", "format": "date-time" }
      },
      "first_seen_after": {
        "name": "first_seen_after",
        "in": "query",
        "schema": { "type": "string", "format": "date-time" }
      },
      "status": {
        "name": "status",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": ["active", "closed", "all"],
          "default": "active"
        }
      },
      "sort": {
        "name": "sort",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": ["recently_discovered", "newest_published"],
          "default": "recently_discovered"
        }
      }
    },
    "responses": {
      "JobList": {
        "description": "Compact canonical job summaries.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/JobListEnvelope" }
          }
        }
      },
      "JobDetail": {
        "description": "Canonical job with sanitized evidence.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/JobDetailEnvelope" }
          }
        }
      },
      "Taxonomy": {
        "description": "Fixed structured filter vocabularies.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/TaxonomyEnvelope" }
          }
        }
      },
      "Meta": {
        "description": "Provider freshness and catalog metadata.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MetaEnvelope" }
          }
        }
      },
      "InvalidRequest": {
        "description": "The structured request is invalid.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "NotFound": {
        "description": "The requested job was not found.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "RemoteLens is read-only.",
        "headers": { "Allow": { "schema": { "type": "string" } } },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "RateLimited": {
        "description": "The per-IP API limit was exceeded.",
        "headers": { "Retry-After": { "schema": { "type": "integer" } } },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      }
    },
    "schemas": {
      "Meta": {
        "type": "object",
        "required": ["generated_at", "request_id"],
        "properties": {
          "generated_at": { "type": "string", "format": "date-time" },
          "request_id": { "type": "string" },
          "next_cursor": { "type": ["string", "null"] }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error", "meta"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "field": { "type": "string" },
              "message": { "type": "string" }
            }
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "JobSummary": {
        "type": "object",
        "required": ["id", "slug", "title", "company", "status", "sources"],
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "company": { "type": "string" },
          "status": { "enum": ["active", "stale", "closed"] },
          "sources": { "type": "array", "items": { "type": "object" } },
          "description_excerpt": { "type": "string" }
        }
      },
      "JobDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/JobSummary" },
          {
            "type": "object",
            "required": [
              "description_html",
              "description_text",
              "provenance",
              "source_records",
              "conflicts"
            ],
            "properties": {
              "description_html": { "type": "string" },
              "description_text": { "type": "string" },
              "provenance": { "type": "array", "items": { "type": "object" } },
              "source_records": {
                "type": "array",
                "items": { "type": "object" }
              },
              "conflicts": { "type": "array", "items": { "type": "object" } }
            }
          }
        ]
      },
      "JobListEnvelope": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/JobSummary" }
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "JobDetailEnvelope": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/JobDetail" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "Taxonomy": {
        "type": "object",
        "properties": {
          "employment_types": { "type": "array" },
          "remote_scopes": { "type": "array" },
          "role_families": { "type": "array" },
          "salary_currencies": { "type": "array" },
          "salary_periods": { "type": "array" },
          "seniorities": { "type": "array" },
          "sorts": { "type": "array" },
          "sources": { "type": "array" },
          "statuses": { "type": "array" },
          "tag_modes": { "type": "array" },
          "travel_required": { "type": "array" },
          "visa_sponsorship": { "type": "array" }
        }
      },
      "TaxonomyEnvelope": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/Taxonomy" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "ProviderMeta": {
        "type": "object",
        "required": ["key", "enabled", "status", "active_count"],
        "properties": {
          "key": { "type": "string" },
          "enabled": { "type": "boolean" },
          "status": { "type": "string" },
          "active_count": { "type": "integer" },
          "last_complete_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "last_successful_at": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      },
      "CatalogMeta": {
        "type": "object",
        "required": [
          "api_version",
          "taxonomy_version",
          "cache_epoch",
          "providers",
          "total_active_jobs"
        ],
        "properties": {
          "api_version": { "type": "string" },
          "taxonomy_version": { "type": "string" },
          "cache_epoch": { "type": "string" },
          "providers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProviderMeta" }
          },
          "total_active_jobs": { "type": "integer" },
          "last_completed_cycle": { "type": ["object", "null"] }
        }
      },
      "MetaEnvelope": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/CatalogMeta" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      }
    }
  }
}
