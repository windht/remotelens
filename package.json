{
  "name": "remotelens",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/sanitize-build-output.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "cf:typegen": "wrangler types",
    "cf:dry-run": "wrangler deploy --dry-run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply remotelens-catalog --local",
    "db:migrate:check": "vitest run tests/migrations",
    "ingest:live-check": "tsx scripts/live-fetch.ts",
    "skill:check": "vitest run tests/unit/remotelens-skill.test.ts",
    "cf:prod-dry-run": "wrangler deploy --config wrangler.production.jsonc --dry-run",
    "cf:prod-deploy": "wrangler deploy --config wrangler.production.jsonc",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm db:migrate:check && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.33",
    "cheerio": "^1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "5.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.6",
    "tailwind-merge": "3.6.0",
    "ulid": "3.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.48.0",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "6.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wrangler": "4.115.0"
  }
}
